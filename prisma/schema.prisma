// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum TabStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum DebtStatus {
  OPEN
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  PIX
}

enum StockMovementType {
  INBOUND
  OUTBOUND
}

enum StockMovementReason {
  SALE
  CANCELLATION_REVERSAL
  RESTOCK
  MANUAL_ADJUSTMENT
}

enum ComboGroupType {
  CATEGORY_CHOICE
  FIXED_PRODUCT
  PRODUCT_CHOICE
}

model Settings {
  id            String  @id @default(uuid())
  isStoreOpen   Boolean @default(true)
  minOrderValue Int     @default(1000) // in cents
  deliveryFee   Int     @default(0) // in cents
  pixKey        String? // pix key shown at delivery checkout
  operatorPin   String? // shared PIN/password to unlock the PDV screen

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  displayOrder Int       @default(0)
  products     Product[]

  comboGroupCategories ComboGroupCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Int // in cents
  imageUrl    String?
  available   Boolean @default(true)

  currentStock Int @default(0)
  minimumStock Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  items OrderItem[]

  comboGroupFixedItems     ComboGroupFixedItem[]
  comboGroupChoiceProducts ComboGroupChoiceProduct[]
  orderComboItems          OrderComboItem[]
  stockMovements           StockMovement[]
  saleItems                SaleItem[]
  tabItems                 TabItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ==========================================
// PDV — CashRegister, Sale, SaleItem (current priority)
// ==========================================

model CashRegister {
  id String @id @default(uuid())

  status CashRegisterStatus @default(OPEN)

  openingAmount         Int // cents
  reportedClosingAmount Int? // cents, filled in only when closing

  sales Sale[]
  tabs  Tab[]

  // credit given out in this shift, and credit from any shift received in it
  debts        Debt[]
  debtPayments DebtPayment[]

  openedAt DateTime  @default(now())
  closedAt DateTime?

  @@map("cash_registers")
}

model Sale {
  id String @id @default(uuid())

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  total         Int // cents
  paymentMethod PaymentMethod

  items          SaleItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Int // snapshot of the price at the time of sale

  createdAt DateTime @default(now())

  @@map("sale_items")
}

// Open bar tab ("comanda"): the customer consumes over time and only pays when
// leaving. Deliberately NOT a Sale — stock is deducted item by item as the item
// is added, so a Tab never produces the Sale+StockMovement pair that every row
// in `sales` is expected to have. Revenue reports aggregate Sale + closed Tab.
model Tab {
  id String @id @default(uuid())

  customerName String // free text, there is no customer registry

  status TabStatus @default(OPEN)

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  // Only filled in on close — an OPEN tab has not chosen how it will pay yet,
  // and a tab closed on credit never will: it has a `debt` instead. So a CLOSED
  // tab with a null paymentMethod is a fiado tab, not a bug.
  paymentMethod PaymentMethod?

  items TabItem[]

  debt Debt?

  openedAt DateTime @default(now())
  // when the tab stopped being OPEN — the moment it was paid for a CLOSED tab,
  // the moment it was discarded for a CANCELLED one. `status` tells them apart,
  // so any revenue query must filter on it and not on this column alone.
  closedAt DateTime?

  @@map("tabs")
}

model TabItem {
  id String @id @default(uuid())

  tabId String
  tab   Tab    @relation(fields: [tabId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Int // snapshot of the price at the moment the item was added

  // Removing an item mistakenly added is a soft cancel, never a DELETE: the row
  // has to survive so the OUTBOUND movement and its CANCELLATION_REVERSAL both
  // keep pointing at it. Cancelled items are excluded from the tab and total.
  cancelledAt DateTime?

  stockMovements StockMovement[]

  createdAt DateTime @default(now())

  @@map("tab_items")
}

// Audit trail for every stock in/out — counter sales (PDV) and delivery
// orders (future) feed the same table.
model StockMovement {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type     StockMovementType
  reason   StockMovementReason
  quantity Int

  // movement source — at most one of the three is filled, depending on the reason
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  tabItemId String?
  tabItem   TabItem? @relation(fields: [tabItemId], references: [id])

  createdAt DateTime @default(now())

  @@map("stock_movements")
}

// ==========================================
// Fiado — customers who take goods now and pay later
// ==========================================

// A real customer record, unlike the free text in Tab.customerName. Credit needs
// one: to know that the "João" who owes 340 is the same João who came back today.
model Customer {
  id String @id @default(uuid())

  name  String
  phone String?
  notes String?

  debts Debt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Debt {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Persisted on purpose, unlike Tab.total: this is not a derived total but the
  // amount that was agreed when the goods went out on credit. It must not move
  // afterwards, whatever happens to the tab it came from.
  amount Int // cents

  // OPEN/PAID is a state transition, so it is stored (like Tab.status). The
  // outstanding balance is NOT — it is always amount minus the payments.
  status DebtStatus @default(OPEN)

  // where it came from — nullable so a debt can later originate somewhere other
  // than a tab (a counter sale, an adjustment) without a migration
  tabId String? @unique
  tab   Tab?    @relation(fields: [tabId], references: [id])

  // the shift that gave the credit out, so its summary can report it
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  payments DebtPayment[]

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@map("debts")
}

model DebtPayment {
  id String @id @default(uuid())

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  amount        Int // cents — partial payments are allowed, so this is not the debt total
  paymentMethod PaymentMethod

  // The shift that physically received the money, which is NOT the shift that
  // gave the credit: a debt from last week paid today belongs in today's drawer.
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  createdAt DateTime @default(now())

  @@map("debt_payments")
}

// ==========================================
// Delivery — paused for now, kept for later
// ==========================================

model Order {
  id           String @id @default(uuid())
  customerName String
  phone        String
  address      String

  total       Int // in cents
  deliveryFee Int @default(0)

  status OrderStatus @default(PENDING)

  paymentMethod  PaymentMethod
  changeFor      Int?
  noChangeNeeded Boolean       @default(false)

  stockDeducted Boolean @default(false)
  autoPrinted   Boolean @default(false)

  items  OrderItem[]
  combos OrderCombo[]

  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid())
  quantity Int

  price Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

model Combo {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
  available   Boolean @default(true)

  groups      ComboGroup[]
  orderCombos OrderCombo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("combos")
}

model ComboGroup {
  id      String @id @default(uuid())
  comboId String
  combo   Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)

  type  ComboGroupType
  label String

  minQuantity Int  @default(1)
  maxQuantity Int?

  categories     ComboGroupCategory[]
  fixedItems     ComboGroupFixedItem[]
  choiceProducts ComboGroupChoiceProduct[]

  orderComboItems OrderComboItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("combo_groups")
}

model ComboGroupCategory {
  id           String     @id @default(uuid())
  comboGroupId String
  comboGroup   ComboGroup @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([comboGroupId, categoryId])
  @@map("combo_group_categories")
}

model ComboGroupFixedItem {
  id           String     @id @default(uuid())
  comboGroupId String
  comboGroup   ComboGroup @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  @@unique([comboGroupId, productId])
  @@map("combo_group_fixed_items")
}

model ComboGroupChoiceProduct {
  id           String     @id @default(uuid())
  comboGroupId String
  comboGroup   ComboGroup @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([comboGroupId, productId])
  @@map("combo_group_choice_products")
}

model OrderCombo {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  comboId String
  combo   Combo  @relation(fields: [comboId], references: [id])

  price Int

  items OrderComboItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_combos")
}

model OrderComboItem {
  id           String     @id @default(uuid())
  orderComboId String
  orderCombo   OrderCombo @relation(fields: [orderComboId], references: [id], onDelete: Cascade)

  comboGroupId String
  comboGroup   ComboGroup @relation(fields: [comboGroupId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_combo_items")
}
